; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="3"
run/main_scene="uid://dyn82850wijok"
config/features=PackedStringArray("4.6", "Mobile")

[autoload]

GameMode="*res://GameMode.gd"
SaveManager="*res://SaveManager.gd"
TouchResolver="*res://TouchResolver.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[global_group]

needs_floor=""
placement_zone=""
floor_seam=""

[input_devices]

sensors/enable_magnetometer=true

[rendering]

renderer/rendering_method="mobile"

[xogot]

project/editorState=[]
project/shaderEditorState=[]
project/breakpoints={}
project/disabled_breakpoints={}
